# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# Asaas Payment Gateway
ASAAS_API_KEY=your-asaas-api-key
ASAAS_API_URL=https://sandbox.asaas.com/api/v3  # Use https://api.asaas.com/v3 for production
ASAAS_WEBHOOK_TOKEN=your-webhook-secret-token  # Generate a secure random string

# WhatsApp Integration - Baileys (Recomendado - Grátis e Auto-hospedado)
# Para desenvolvimento local:
BAILEYS_SERVICE_URL=http://localhost:3001
# Para produção (depois de fazer deploy do serviço Baileys):
# BAILEYS_SERVICE_URL=https://baileys.seu-dominio.com

# URL pública do Lidzy (necessária para webhooks do Baileys)
# Desenvolvimento:
NEXT_PUBLIC_URL=http://localhost:3000
# Produção:
# NEXT_PUBLIC_URL=https://seu-dominio.com

# WhatsApp Integration - Evolution API (Alternativa, se você usar ao invés de Baileys)
EVOLUTION_API_URL=https://your-evolution-api-url
EVOLUTION_API_KEY=your-evolution-api-key

# Email Notifications (Resend)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@yourdomain.com

# Optional: n8n Webhook (if used)
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook

# Node Environment
NODE_ENV=development  # or production
